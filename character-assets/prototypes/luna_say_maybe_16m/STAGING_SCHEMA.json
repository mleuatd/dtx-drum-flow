{
  "schemaVersion": 1,
  "required": [
    "actionKey",
    "runtimeKey",
    "block",
    "measureRange",
    "hit",
    "rebound",
    "manifestStatus",
    "qaStatus",
    "registrationStatus"
  ],
  "hitReboundFields": [
    "source",
    "sha256",
    "dimensions",
    "dropboxPath",
    "githubPath",
    "binaryQa",
    "visualQa"
  ],
  "statusValues": [
    "DRAFT",
    "READY_FOR_BINARY_QA",
    "READY_FOR_STATIC_QA",
    "READY_FOR_FORMAL_SAVE",
    "RUNTIME_PENDING",
    "RUNTIME_READY",
    "LIVE_QA_PASSED",
    "DONE",
    "REJECTED"
  ],
  "rule": "One hit/rebound pair staging JSON is the single transfer record used by Dropbox/GitHub/manifest/inventory/action-map/ledger update steps."
}
